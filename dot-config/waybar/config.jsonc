{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/screenshot",
    "custom/temp",
    "network",
    "power-profiles-daemon",
    "custom/audio-device",
    "backlight",
    "battery",
    "tray"
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "on-click": "activate"
  },
  "hyprland/submap": {
    "format": " {}"
  },
  "tray": {
    "icon-size": 20,
    "spacing": 10
  },
  "clock": {
    "format": "<span>󰥔</span> {:%H:%M}",
    "format-alt": " {:%A, %B %d, %Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "right"
  },
  "cpu": {
    "format": "<span>󰘚</span> {usage}%",
    "tooltip": true,
    "on-click": "foot btm"
  },
  "memory": {
    "format": "<span>󰍛</span> {}%",
    "on-click": "foot btm"
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% <span>{icon}</span>",
    "format-charging": "{capacity}% <span>󰂄</span>",
    "format-plugged": "{capacity}% <span>󰚥</span>",
    "format-alt": "{time} <span>{icon}</span>",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "network": {
    "format-wifi": "<span></span>  {signalStrength}%",
    "format-ethernet": "<span></span> {ifname}",
    "format-linked": "{ifname} (No IP) <span></span>",
    "format-disconnected": "Disconnected <span>⚠</span>",
    "format-alt": "<span></span> {essid} ({signalStrength}%)",
    "on-click": "nm-connection-editor"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{percent}% <span>{icon}</span>",
    "format-icons": [
      "󰃚",
      "󰃛",
      "󰃜",
      "󰃝",
      "󰃞",
      "󰃟",
      "󰃠",
      "󰃡"
    ],
    "on-scroll-up": "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    },
    "on-click": "~/.config/waybar/cycle-power-profile.sh"
  },
  "custom/screenshot": {
    "format": "󰄄",
    "on-click": "hyprshot -m region"
  },
  "custom/temp": {
    "format": "󰔏",
    "on-click": "~/.config/waybar/toggle_temp.sh"
  },
  "custom/audio-device": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/select-audio-device.sh info",
    "interval": 5,
    "on-click": "~/.config/waybar/select-audio-device.sh select",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": false
  }
}
